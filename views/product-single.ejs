<body id="body">
<!-- Start Top Header Bar -->
<%- include('partials/header') %>

<section class="single-product" style="padding: 60px 0 0px;">
	<div class="container">
		<div class="row">
			<div class="col-md-6">
				<ol class="breadcrumb">
					<li><a href="/">Home</a></li>
					<li><a href="/shop">Shop</a></li>
					<li class="active"><%= foundproduct.prod_title %></li>
				</ol>
			</div>
		</div>
		<div class="row mt-20">	
			<div class="col-md-5">
				<div class="single-product-slider">
					<div id='carousel-custom' class='carousel slide' data-ride='carousel'>
						<div class='carousel-outer'>
							<!-- me art lab slider -->
							<div class='carousel-inner '>
								<div class='item active'>
									<img src='<%= (foundproduct.prod_img1).slice(7) %>' alt='<%= foundproduct.prod_title %>' data-zoom-image="<%= (foundproduct.prod_img1).slice(7) %>" />
								</div>
								<div class='item'>
									<img src='<%= (foundproduct.prod_img2).slice(7) %>' alt='<%= foundproduct.prod_title %>' data-zoom-image="<%= (foundproduct.prod_img2).slice(7) %>" />
								</div>
								<div class='item'>
									<img src='<%= (foundproduct.prod_img3).slice(7) %>' alt='<%= foundproduct.prod_title %>' data-zoom-image="<%= (foundproduct.prod_img3).slice(7) %>" />
								</div>
							
							</div>
							
							<!-- sag sol -->
							<a class='left carousel-control' href='#carousel-custom' data-slide='prev'>
								<i class="tf-ion-ios-arrow-left"></i>
							</a>
							<a class='right carousel-control' href='#carousel-custom' data-slide='next'>
								<i class="tf-ion-ios-arrow-right"></i>
							</a>
						</div>
						
						<!-- thumb -->
						<ol class='carousel-indicators mCustomScrollbar meartlab'>
							<li data-target='#carousel-custom' data-slide-to='0' class='active'>
								<img src='<%= (foundproduct.prod_img1).slice(7) %>' alt='<%= foundproduct.prod_title %>' />
							</li>
							<li data-target='#carousel-custom' data-slide-to='1'>
								<img src='<%= (foundproduct.prod_img2).slice(7) %>' alt='<%= foundproduct.prod_title %>' />
							</li>
									<li data-target='#carousel-custom' data-slide-to='2'>
								<img src='<%= (foundproduct.prod_img3).slice(7) %>' alt='<%= foundproduct.prod_title %>' />
							</li>
							
							
						</ol>
					</div>
				</div>
			</div>
			<div class="col-md-7">
				<div class="single-product-details">
					<h2><%= foundproduct.prod_title %></h2> 
					<h4><%= foundproduct.prod_subtitle %></h4>
					<div class="product-price">
						<span class="compare">₹ <%= foundproduct.prod_originalprice %></span>
						<span>₹ <%= foundproduct.prod_discountedprice %></span>
					</div>
					<svg viewBox="0 0 1000 200" class='rating'>
						<defs>
						    <polygon id="star" points="100,0 131,66 200,76 150,128 162,200 100,166 38,200 50,128 0,76 69,66 "/>
                  
						      <clipPath id="stars">
						        <use xlink:href="#star"/>
						        <use xlink:href="#star" x="20%"/>
						        <use xlink:href="#star" x="40%"/>
						        <use xlink:href="#star" x="60%"/>
						        <use xlink:href="#star" x="80%"/>
						      </clipPath>
                  
						    </defs>		  
	    				<rect class='rating__background' clip-path="url(#stars)"></rect>  
	    				<!-- Change the width of this rect to change the rating -->
	    				<%	if(review.length > 0 ){ %>
	    				<% let ttlratings = 0; let avrg=0;let width=0; %>
	    				<%	for(i in review){ %>
						 <%	ttlratings += review[i].star; %>
						 	

						 <% } %>
						 <%= ttlratings %>
						 <% avrg= ttlratings / review.length %>
						 <% width= (avrg*100)/5 %>
						 
						 <!-- <%= avrg  %>
						 <%= width %> -->

						 <rect width="<%= width %>%" class='rating__value' clip-path="url(#stars)"></rect>
						 <% }else{ %>
						  <rect width="80%" class='rating__value' clip-path="url(#stars)"></rect>

						 <% } %>
					</svg>
				<%	if(review.length > 0 ){ %>
					<a href="#review"><span style="color:red;vertical-align: text-bottom;font-weight: bold;"><u>&nbsp;<%= review.length %> Reviews</u></span></a>
					<% }else{ %>
					<a href="#review"><span style="color:red;vertical-align: text-bottom;font-weight: bold;"><u>&nbsp;23 Reviews</u></span></a>
					
					<% } %>
					<p class="product-description mt-20" style="font-size: 16px!important;">
						<%= foundproduct.prod_desc %>
					</p>
					
					<div class="color-swatches">


						<span><h5>COLOR :</h5></span>
		<% if(foundproduct.prod_title == 'Himster Wireless Doorbell (White 1 Transmitter & 1 Receiver)' || foundproduct.prod_title == 'Hohem iSteady X (White)'){ %>
						<ul>
							<li>
								<a href="/products/Himster Wireless Doorbell (White 1 Transmitter & 1 Receiver)" class="swatch-white"></a>
							</li>
							<li>
								<a href="/products/Himster Wireless Doorbell (Black 1 Transmitter & 1 Receiver)" class="swatch-black"></a>
							</li>
						</ul>
						<% }else{ %>
						<ul>
							<li>
								<a href="/products/Himster Wireless Doorbell (White 1 Transmitter & 1 Receiver)" class="swatch-white"></a>
							</li>
							<li>
								<a href="/products/Himster Wireless Doorbell (Black 1 Transmitter & 1 Receiver)" class="swatch-black"></a>
							</li>
						</ul>
						<% } %>

					</div>
					 <div>
						<% if(foundproduct.prod_title == 'Himster Wireless Doorbell (White 1 Transmitter & 1 Receiver)' || foundproduct.prod_title == 'Himster Wireless Doorbell (White 1 Transmitter & 2 Receivers)' || foundproduct.prod_title == 'Himster Wireless Doorbell (White 2 Transmitters & 1 Receiver)' || foundproduct.prod_title == 'Himster Wireless Doorbell (White 2 Transmitters & 3 Receivers)' || foundproduct.prod_title == 'Himster Wireless Doorbell (White 2 Transmitters & 4 Receivers)'){ %>
						 <span><h5>SET</h5></span>
						 <ul>
							<a href="/products/Himster Wireless Doorbell (White 1 Transmitter & 1 Receiver)" class="btn btn-medium btn-solid-border">White 1 Transmitter & 1 Receiver</a> 
							<a href="/products/Himster Wireless Doorbell (White 1 Transmitter & 2 Receivers)" class="btn btn-medium btn-solid-border">White 1 Transmitter & 2 Receivers </a>
							<a href="/products/Himster Wireless Doorbell (White 2 Transmitters & 1 Receiver)" class="btn btn-medium btn-solid-border">White 2 Transmitters & 1 Receiver </a>
							<a href="/products/Himster Wireless Doorbell (White 2 Transmitters & 3 Receivers)" class="btn btn-medium btn-solid-border">White 2 Transmitters & 3 Receivers </a>
							<a href="/products/Himster Wireless Doorbell (White 2 Transmitters & 4 Receivers)" class="btn btn-medium btn-solid-border">White 2 Transmitters & 4 Receivers </a>
						</ul>
						<% } %>	
						
						<% if(foundproduct.prod_title == 'Himster Wireless Doorbell (Black 1 Transmitter & 1 Receiver)' || foundproduct.prod_title == 'Himster Wireless Doorbell (Black 1 Transmitter & 2 Receivers)' || foundproduct.prod_title == 'Himster Wireless Doorbell (Black 2 Transmitters & 1 Receiver)' || foundproduct.prod_title == 'Himster Wireless Doorbell (Black 2 Transmitters & 3 Receivers)' || foundproduct.prod_title == 'Himster Wireless Doorbell (Black 2 Transmitters & 4 Receivers)'){ %>
						 <span><h5>SET</h5></span>
						<ul>
							<a href="/products/Himster Wireless Doorbell (Black 1 Transmitter & 1 Receiver)" class="btn btn-medium btn-solid-border">Black 1 Transmitter & 1 Receiver</a> 
							<a href="/products/Himster Wireless Doorbell (Black 1 Transmitter & 2 Receivers)" class="btn btn-medium btn-solid-border">Black 1 Transmitter & 2 Receivers </a>
							<a href="/products/Himster Wireless Doorbell (Black 2 Transmitters & 1 Receiver)" class="btn btn-medium btn-solid-border">Black 2 Transmitters & 1 Receiver </a>
							<a href="/products/Himster Wireless Doorbell (Black 2 Transmitters & 3 Receivers)" class="btn btn-medium btn-solid-border">Black 2 Transmitters & 3 Receivers </a>
							<a href="/products/Himster Wireless Doorbell (Black 2 Transmitters & 4 Receivers)" class="btn btn-medium btn-solid-border">Black 2 Transmitters & 4 Receivers </a>
						</ul> 
						<% } %>

					</div> 

					<div class="product-category">
						
						<ol style="font-size: 15px;">
							<li><a><i class='fas fa-shipping-fast'></i> FREE shipping on all orders.</a></li>
							<li><a><i class='fas fa-money-check-alt'></i>  10 days money back guarantee.</a></li>
						</ol>
					</div>
				<!-- 	<a href="cart" class="btn btn-main mt-20" id="buynow">Add To Cart</a> -->


	        						<% if(authentication){ %>

	        						<% if(foundproduct.instock){ %>
									<form method="POST" action="/cart">
									<input type="hidden" name="userId" value="<%= usr._id %>">	
									<input type="hidden" name="productId" value="<%= foundproduct._id %>">
									<input type="hidden" name="quantity" value="1">
									<input type="hidden" name="name" value="<%= foundproduct.prod_title %>">
									<input type="hidden" name="desc" value="<%= foundproduct.prod_desc %>">
									<input type="hidden" name="img" value="<%= (foundproduct.prod_img1).slice(7) %>">
									<input type="hidden" name="price" value="<%= foundproduct.prod_discountedprice %>">
									<button class="btn btn-main mt-20" type="submit">Add To Cart</button>
									</form>


									<% }else{ %>
									<button class="btn btn-main" type="button">Out-Of-Stock</button>

									<% } %>


	        						<% }else{ %>
									<a href="/login" class="btn btn-main mt-20">Add To Cart</a>
									<% } %>


					<div class="post-social-share" style="margin-top:40px ">
				        <div class="social-media-icons">
				        	<ul>
								<li>
									<!-- ShareThis BEGIN -->
									<div class="sharethis-inline-share-buttons"></div>
									<!-- ShareThis END -->
								</li>
							</ul>
				        </div>
				    </div>

				</div>

			</div>
