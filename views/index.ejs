/*=====================================================================================================*/

.cart-dropdown .remove {
    padding: 1px 6px;
    position: absolute;
    right: 0;
    top: 0;
    border: 0px;
    background-color: transparent;
    color: #7f7f7f;
    font-size: 12px;
}

	.contact-number ul .dropdown-menu{right: auto}

	.contact-number ul .dropdown-menu li a {
    color: #222;
    font-size: 12px;
    border: 1px solid transparent;
