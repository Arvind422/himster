						<img src="images\logo.png" alt="" width="150" height="30">
					</a>
				</div>
				<div class="contact-number pdt-20">
			      	<ul class="top-menu list-inline">
						<li class="dropdown dropdown-slide">
						<% if(authentication){ %>
				            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-delay="350" role="button" aria-haspopup="true" aria-expanded="false"> Hello, <%= usr.firstname %> <span class="tf-ion-ios-arrow-down"></span></a>
				            <ul class="dropdown-menu">
				            	 <%  if(usr.email){ %>
      							<%  if(usr.email == 'storehimster@gmail.com'){ %>
			                      <li><a href="/admin/myproducts">Admin Panel</a></li>
			                    <% } %>
			                    <% } %>
								<li><a href="/profile-details">My Account</a></li>
								<li><a href="/order">my orders</a></li>
								<li><a href="/wishlist">wishlist</a></li>
								<li><a href="/cart">cart</a></li>
								<li><a href="/logout">Logout</a></li>	
				            </ul>

				            <% }else{ %>

				            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-delay="350" role="button" aria-haspopup="true" aria-expanded="false"> Hello, Guest <span class="tf-ion-ios-arrow-down"></span></a>
				            <ul class="dropdown-menu">
								<li><a href="/register">Register</a></li>
								<li><a href="/login">Login</a></li>
								
				            </ul>

				            <% } %>


				            				        </li>
			      	</ul>
					
				</div>
			</div>
			<div class="col-md-6 col-xs-12 col-sm-5 search hidden-xs" style="padding:0px!important">
