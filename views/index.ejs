					<a href="/">
						<!-- replace logo here -->
						<img src="images\logo.png" alt="" width="150" height="30">
					</a>
				</div>
			</div>	
			<div class="col-md-3 col-xs-12 col-sm-4 pdt-20">
				<!-- Cart -->
				<ul class="top-menu text-right list-inline">
	          <li class="dropdown cart-nav dropdown-slide">
	          
	        <% if(numofcarts > 0){ %>

	            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown"><i class="tf-ion-android-cart"></i>Cart<span id="displaycart"><%= numofcarts %></span></a>

	            <div class="dropdown-menu cart-dropdown">

	            	<!-- FOR ITEMS MORE THAN 2..ADD SCROLL -->
					<div data-action='scroll' id="style-4">
					<% for(i in foundcarts){ %>
	            	<!-- Cart Item -->
	            	<div class="media">
	            		<a class="pull-left" href="#">
	            			<img  class="media-object" src="<%= foundcarts[i].img %>" alt="<%= foundcarts[i].name %>" />
	            		</a>
	            		<div class="media-body">
	            			<h4 class="media-heading"><a href="/products/<%= foundcarts[i].name %>"><%= foundcarts[i].name %></a></h4>
	            			<div class="cart-price">
                              <span><%= foundcarts[i].quantity %> x</span>
                              <span>₹ <%= foundcarts[i].price %></span>
                            </div>
                            <h5><strong>₹ <%= foundcarts[i].ttlprice %></strong></h5>
	            		</div>
                        <!-- <a href="#" class="remove"><i class="tf-ion-close"></i></a> -->

                        <form method="POST" action="/deletecart">
                  <input type="hidden" name="productId" value="<%= foundcarts[i]._id %>">
              
                  <input type="hidden" name="userId" value="<%= usr._id %>">
                <button type="submit" class="remove"><i class="tf-ion-close"></i></button>
              </form>
	            	</div><!-- / Cart Item -->
	          <%  } %>
					</div>
	            	
	            	<div class="cart-summary">
                        <span>Total</span>
                        <% let ttl =0; %>
                        <% for(j in foundcarts){  %>
                      <% ttl = ttl + foundcarts[j].ttlprice %>
                      <% } %>
                        <span class="total-price">₹ <%= ttl %></span>

                    </div>
                    <ul class="text-center cart-buttons">
                    	<li><a href="/cart" class="btn btn-small">View Cart</a></li>
                    	<li><a href="/checkout/<%= usr._id %>" class="btn btn-small btn-solid-border">Checkout</a></li>
                    </ul>
                </div>
         <% }else{ %>
	            <a href="/cart"><i class="tf-ion-android-cart"></i>Cart<span id="displaycart">0</span></a>

     <% } %>

	          </li><!-- / Cart -->
				<!-- Wishlist -->
	          <li>
	          <% if(numofwishlists > 0){ %>
	          
	          	<a href="/wishlist"><i class="tf-ion-ios-heart"></i>Wishlist<span id="displaycart"><%= numofwishlists %></span></a>
	       <%  }else{ %>
	<a href="/wishlist"><i class="tf-ion-ios-heart"></i>Wishlist<span id="displaycart">0</span></a>

	  <% } %>
	          </li>
			 <!--  / Wishlist -->
			<!-- Search -->
			<!-- SEARCH REULTS ARE IN FOOTER.EJS -->
	          <li class="dropdown search dropdown-slide visible-xs">
	            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown"><i class="tf-ion-ios-search-strong"></i> Search</a>
	            <ul class="dropdown-menu search-dropdown">
	              <li><form><input type="search" class="form-control search-field1" placeholder="Search..."></form>
	              <div style="display:none" class="result-list search-results1"></div>
	              </li>
	            </ul>	
	          </li>
			<!-- / Search -->
		    
	        	</ul><!-- / .nav .navbar-nav .navbar-right -->
			</div>
		</div>
	</div>
</section><!-- End Top Header Bar -->


