.category-box img.img01 ,.category-box img.img02{	
	float: right;
	height: 100%;
    width: auto;
} 
.category-box img.img03{
	margin-top: 100px;
}
 
.product-item .product-thumb .preview-meta li form button{margin: 0px;
    padding: 0px;
    background: transparent;
    border: 0px;}

#displaycart {
   background-color: #cf5053;
    border-radius: 50%;
    color: #fff;
    font-size: 9px;
    line-height: 1;
    padding: 3px 5px;
    position: relative;
    left: 0px;
    top: -10px;
    transition: all 0.3s ease;
}
@media screen and (max-width: 992px) and (min-width: 768px) {
	.category-box.category-box-2 {
    min-height: 500px;
	}

	.category-box
	{
		min-height: 420px;
	}
	.category-box .content {
    top: 50%;
    left: 40%;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    text-align: center;
	}
	.category-box img.img03{
	    margin-top: 0px;
	height: 100%;
    width: auto;
	}
	.category-box .c03 {
    top: 50%;
    left: 70%;
	}
}


@media only screen and (max-width: 768px){
	.dropdown-menu {
	      display: none !important;
	  }
	  .open .dropdown-menu {
	      display: block !important;
	  }
	.gimbalpd{padding-top: 20px;}
	.menu-title{margin-top: 15px;}
	.top-header .container {
		padding-top: 15px;
    padding-bottom: 15px;
	}
	.top-header .dropdown-menu {
    right: auto;
    left: auto;}
        
	.category-box .content {
    top: 50%;
    left: 70%;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    text-align: center;
	}
	.category-box img.img01 ,.category-box img.img02{
	margin-left: 0px;
	float: left;
	}
	.category-box img.img03{
	    margin-top: 0px;
	height: 100%;
    width: auto;
	}
}
	 @media only screen and (max-width: 400px){
    .btn-main {padding: 14px 8px;}
    .category-box img.img02{margin-top: 70px!important;margin-left: 15px!important}
    .category-box img.img03{margin-top: 105px!important}
    .category-box img.img03{
    	height: auto;
    	width: 100%;
    }
    .category-box .c02{ 
       top: 25%;
    left: 45%;
    width: auto;
	}
    .category-box .c03{ 
       top: 15%;
    left: 45%;
    width: auto;
	}
}
	@media (max-width: 992px){
	.container {
    width: 100%;
