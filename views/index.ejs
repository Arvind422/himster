<style>
.tp-bgimg .defaultimg ,.rev-slidebg{
	background-size: contain !important;
	background-position: center !important;
	background-color: white;
}

.top-header .search form a i {
    top: 9px!important;
    right: 9px!important;
}
.description {
  margin-top: 6px;
}

.highlight {
  font-weight: 900;
  color: black;
}

#full-list {
  font-style: italic;
  padding-left: 10px;
  padding-top: 5px;
}

.right {
  float: left;
}

.search-wrapper {
  padding-right: 5px;
  padding-bottom: 10px;
}

.search-field {
  width: 100%;
}

.result-list {
  border: 1px solid #ddd;
  padding: 3px 3px 0px 3px;
  background-color: white;
}

.result-list-entry {
  padding-bottom: 3px;
}

.result-list-entry a{
  color:#363535f5;
}

.no-results {
  color: #aaa;
  font-style: italic;
  padding-bottom: 3px;
}

.search-results {
     min-height: 34px;
    position: absolute;
    overflow-y: auto;
    width: 100%;
    z-index: 1; 
    font-family: monospace;
}

.feature-list {
  padding-left: 20px;
}

.feature-list li {
  padding-bottom: 5px;
}

/*=====================================================================================================*/

.cart-dropdown .remove {
    padding: 1px 6px;
    position: absolute;
    right: 0;
    top: 0;
    border: 0px;
    background-color: transparent;
    color: #7f7f7f;
    font-size: 12px;
}

	.contact-number ul .dropdown-menu{right: auto}

	.contact-number ul .dropdown-menu li a {
    color: #222;
    font-size: 12px;
    border: 1px solid transparent;
    display: block;
    padding: 8px 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: .3s all;
	}

	.contact-number ul .dropdown-menu>li>a {
    display: block;
    /*padding: 3px 20px;*/
    clear: both;
    font-weight: 400;
    line-height: 1.42857143;
    color: #333;
    white-space: nowrap;
	}

	.contact-number ul .dropdown-menu li a:hover {
    background-color: #000;
    color: #fff;
	}


/*===================================PP=======================================*/
.category-box {
    background: white;}	

.category-box img.img01 ,.category-box img.img02{	
	float: right;
	height: 100%;
    width: auto;
} 
/* .category-box img.img03{
	margin-top: 100px;
} */

.category-box.category-box-2 {
    min-height: 550px;
}
.category-box img {
    transition: all 0.3s ease-in-out;
    width: 88%;
}
 
.product-item .product-thumb .preview-meta li form button{margin: 0px;
    padding: 0px;
    background: transparent;
    border: 0px;}

#displaycart {
   background-color: #cf5053;
    border-radius: 50%;
    color: #fff;
    font-size: 9px;
    line-height: 1;
    padding: 3px 5px;
    position: relative;
    left: 0px;
    top: -10px;
    transition: all 0.3s ease;
}
@media screen and (max-width: 992px) and (min-width: 768px) {
	.category-box.category-box-2 {
    min-height: 500px;
	}

	.category-box
	{
		min-height: 420px;
	}
	.category-box .content {
    top: 50%;
    left: 40%;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    text-align: center;
	}
	.category-box img.img03{
	    margin-top: 0px;
	height: 100%;
    width: auto;
	}
	.category-box .c03 {
    top: 50%;
    left: 70%;
	}
}


@media only screen and (max-width: 768px){
	.dropdown-menu {
	      display: none !important;
	  }
	  .open .dropdown-menu {
	      display: block !important;
	  }
	.gimbalpd{padding-top: 20px;}
	.menu-title{margin-top: 15px;}
	.top-header .container {
		padding-top: 15px;
    padding-bottom: 15px;
	}
	.top-header .dropdown-menu {
    right: auto;
    left: auto;}
        
	.category-box .content {
    top: 50%;
    left: 70%;
    -webkit-transform: translate(-50%, -50%);
    transform: translate(-50%, -50%);
    text-align: center;
	}
	.category-box img.img01 ,.category-box img.img02{
	margin-left: 0px;
	float: left;
	}
	.category-box img.img03{
	    margin-top: 0px;
	height: 100%;
    width: auto;
	}
}
	 @media only screen and (max-width: 400px){
    .btn-main {padding: 14px 8px;}
    .category-box img.img02{margin-top: 70px!important;margin-left: 15px!important}
    .category-box img.img03{margin-top: 105px!important}
    .category-box img.img03{
    	height: auto;
    	width: 100%;
    }
    .category-box .c02{ 
       top: 25%;
    left: 45%;
    width: auto;
	}
    .category-box .c03{ 
       top: 15%;
    left: 45%;
    width: auto;
	}
}
	@media (max-width: 992px){
	.container {
    width: 100%;
	}
}


