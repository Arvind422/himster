


 <!DOCTYPE html>
<html lang="en">
<head>
  <title>Himster | New Orders</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="plugins/themefisher-font/style.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
  


  <style>
    center > a {
    text-transform: capitalize;
    color: #333;
    -webkit-transition: background-color .2s, color .2s;
    transition: background-color .2s, color .2s;
  }
   center > a:hover, center > a:focus {
    background-color: #333;
    color: white !important;
    font-weight: 500;
  }
  
  center.active > a {
    background-color: #333;
    color: #fff;
  }
  </style>
</head>
<body>
  <div class="container" style="width: auto;    margin-top: 20px;">
  <center>
  
    <a href="/admin_orders" class="btn btn-main mt-20" style="float:left ; font-size: 20px;">
      <i class="tf-ion-ios-arrow-back"> Back</i>
    </a>
    
  </center> 
  </div>
<div class="container">
  
  <b>OrderId:- </b> <%= orderid %>
<h3>User Details:-</h3>
<b>Name :- </b><%= fullname %> <br>
<b>Email-id :- </b><%= usermail %> <br>
<b>Mobile No :- </b><%= phone %> <br>
<b>Address :- </b><%= address %><br>
<b>Add. Type :- </b><%= typeofaddress %><br>

<br>
<h3>Ordered Product Details:-</h3>

<% for(i in items){ %>
<img src="<%= items[i].img %>" style = "width: 50%; height: 50%;"><br> 
<h4><%= items[i].name %></h4>
<b>Quantity :- </b><%= items[i].quantity %> <br>
<b>Total :- </b>₹ <%= items[i].ttlprice %> <br>
<b>Desc :- </b><%= items[i].desc %><br>

<% } %>




</div>


</body>
</html>
