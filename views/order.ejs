<!DOCTYPE html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8"> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9"> <![endif]-->
<!--[if gt IE 8]><!--> 
<html class="no-js"> <!--<![endif]-->
<head>

  <title>Himster | Order </title>

<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="description" content="This is the official store of Himster Tech, where the customers can buy all the available products from Himster and get the official customer service. The products ...">
  
  <meta name="author" content="Himster.in">

  <!-- Mobile Specific Meta-->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <!-- Favicon -->
  <link rel="shortcut icon" type="image/x-icon" href="images/favicon.png" />
  
  <!-- Themefisher Icon font -->
  <link rel="stylesheet" href="plugins/themefisher-font/style.css">
  <!-- bootstrap.min css -->
  <link rel="stylesheet" href="plugins/bootstrap/css/bootstrap.min.css">
  
  <!-- Revolution Slider -->
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/fonts/pe-icon-7-stroke/css/pe-icon-7-stroke.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/fonts/font-awesome/css/font-awesome.css">

  <!-- REVOLUTION STYLE SHEETS -->
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/settings.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/layers.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/navigation.css">
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="css/style.css">


  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
  <script type="text/javascript">

  $(document).ready(function () {
      // Handler for .ready() called.
      $('html, body').animate({
          scrollTop: $('#scroll').offset().top
      }, 'slow');
  });

  </script>
  <style>
    .table>tbody>tr>td, .table>tbody>tr>th, .table>tfoot>tr>td, .table>tfoot>tr>th, .table>thead>tr>td, .table>thead>tr>th {text-align: center;}


    .single-product-details .color-swatches span {
        width: auto;
        margin-right: 10px;
    }
    .single-product-details .color-swatches a {
      border-radius: 50px;
      display: inline-block;
        width: 25px;
        height: 25px;
        margin-right: 5px;
        border-radius: 50px;
    }
    .givrating{
      color:blue;
      text-transform: uppercase;
      font-weight: bold;
      margin-top: 10px;
      background: transparent;
    border: 0px;
    }
    .status{
      display: inline-block;
        width: 13px;
        height: 13px;
        margin-right: 5px;
        border-radius: 50px;
    }
    
    .delivered{
      background-color: green;
    }
    .pending{
      background-color: orange;
    }
    .cancelled{
      background-color: red;
    }
    .desc div{
     margin:10px 0px;
      }
    .hide0{display: none}
    .hidemob{display: block;}
     @media only screen and (max-width: 768px) {
      .hide0{display: block;}
    .hidemob{display: none;}
     }
      
    @media only screen and (max-width: 408px) {
    .col-xs-7,.col-xs-5{padding-left: 5px;padding-right: 5px;}  
    .row .text-center #cartimg {
            height: auto;
            vertical-align: middle;
            width: 100%;
        }   
    }

  </style>

</head>

<body id="body">
<!-- Start Top Header Bar -->
<%- include('partials/header') %>
<section class="page-header">
  <div class="container" id="scroll">
    <div class="row">
      <div class="col-md-12">
        <div class="content">
          <h1 class="page-name">Dashboard</h1>
          <ol class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li class="active">My Orders</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="user-dashboard page-wrapper">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <ul class="list-inline dashboard-menu text-center">
            <li><a href="/profile-details">Profile</a></li>
                <li><a href="/address">Address</a></li>
                <li><a class="active" href="/order">Orders</a></li>
                <li><a href="/wishlist">Wishlist</a></li>
        </ul>
        <div class="dashboard-wrapper user-dashboard">
              <div class="row">
                <div class="col-md-12">
                  <div class="block">
                    <div class="product-list">
          
          
                      <!--  SECOND PRODUCT DIV -->
<% if(item.length > 0){ %>
                      <% for(i in item){ %>
                      <% if(item[i].transactionComplete){ %>
                
                      <div class="row mt-30">
                        <% for(j in item[i].items){ %>
                          <div class="col-lg-9 col-md-8 col-sm-8 col-xs-12" style="margin-bottom: 30px;">
                            <div class="col-lg-3 col-md-4 col-sm-5 col-xs-5 text-center">
                              <a href="/order-details/<%= item[i]._id %>"><img id="cartimg" width="150" height="150" src="<%= item[i].items[j].img %>" alt="" /></a>

                            </div>
                            <div class="col-lg-6 col-md-8 col-sm-7 col-xs-7 single-product-details">
                             <a href="/order-details/<%= item[i]._id %>"><%= item[i].items[j].name %></a>
                              <br>
                              <div class="color-swatches">
                                <span>color:</span>
                                <ul>
                                  <li>
                                    <a class="swatch-black"></a>
                                  </li>
                                </ul>
                              </div>  
                              <br>
                              <span class="hide0">₹ <%= item[i].total  %></span>
                            </div>
                          </div>
                          <% } %>

                          <div class="col-lg-1 col-md-1 col-sm-1 col-xs-4 mt-20 hidemob">
                            <label for="" class="hid">Price</label> <br>₹ <%= item[i].total  %>
                          </div>
                          <div class="col-lg-2 col-md-3 col-sm-3 col-xs-12 mt-20 desc text-center">
                            <div>
                               <% var d = new Date(); %>
                              <% var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]; %>
                              <a class="status pending"></a>
                              <span>Order PLaced on <% let ordrdt = ((item[i].orderdate).split(" "))[0].split("-") %><%= ordrdt[2] %>
                                <%= months[(d.getMonth())] %>

                              </span>
                              
                             
                            </div>    
                    <div>
                      <% if(item[i].orderComplete == false && item[i].orderCancelled == false){ %>
  
                      <b>Status: </b> 
                      <span><a href="https://marutiair.com/Doc_Tracking.aspx?No=900369922&Tmp=567337" class="givrating" target="_blank"><u>On the Way, Track Order<u></a></span>
                      <% } %>
                      <% if(item[i].orderComplete == true){ %>
  
                      <b>Status: </b> 
                      <span> Delivered</span>

                         <% if(usr.email){ %>
                        <form action="/prod_ratings" method="POST">

          <input type="hidden" name="img" value="<%= item[i].items[j].img %>">
          <input type="hidden" name="name" value="<%= item[i].items[j].name %>">
          <input type="hidden" name="desc" value="<%= item[i].items[j].desc %>">
          <input type="hidden" name="total" value="<%= item[i].total %>">
          <input type="hidden" name="fullname" value="<%= usr.fullname %>">
          <input type="hidden" name="email" value="<%= usr.email %>">
        

        
                              <button type="submit" class="givrating"><u><i class="tf-ion-ios-star"></i> Rate & Review Product<u></button>
                        </form>

<% }else{ %>
<a href="/update-profile" class="givrating"><u><i class="tf-ion-ios-star"></i> Rate & Review Product<u></a>
<% } %>





                      <% } %>


                      <% if(item[i].orderCancelled == true){ %>
  
                      <b>Status: </b> 
                      <span> Cancelled</span>
                      <% } %>

                    </div>
                    <div>




                   


                            </div>  
                          </div>
                          
                        </div>

                        <% } %>
                        <% } %>

                        <!-- =============== END PRODUCTS===================-->
<% }else{ %>
<!-- Nothing to Show... -->
<section class="empty-cart page-wrapper">
  <div class="container" style="width:auto">
    <div class="row">
      <div class="col-md-12 ">
        <div class="block text-center">
          <i class="tf-ion-ios-filing-outline"></i>
            <h2 class="text-center">Oops. No Orders placed yet!!!</h2>
            <p>Grab the latest deals fast.</p>
            <a href="/shop" class="btn btn-main mt-20">Let's shop</a>
      </div>
    </div>
  </div>
</section>

<% } %>
                        
                    </div>
                  </div>
                </div>
              </div>
      
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
  </body>
  </html>
