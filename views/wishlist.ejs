<!DOCTYPE html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8"> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9"> <![endif]-->
<!--[if gt IE 8]><!--> 
<html class="no-js"> <!--<![endif]-->
<head>
  
<title>Himster | My Wishlist </title>

<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
   <meta name="description" content="This is the official store of Himster Tech, where the customers can buy all the available products from Himster and get the official customer service. The products ...">
  
  <meta name="author" content="Himster.in">
  <!-- Mobile Specific Meta-->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <!-- Favicon -->
  <link rel="shortcut icon" type="image/x-icon" href="images/favicon.png" />
  
  <!-- Themefisher Icon font -->
  <link rel="stylesheet" href="plugins/themefisher-font/style.css">
  <!-- bootstrap.min css -->
  <link rel="stylesheet" href="plugins/bootstrap/css/bootstrap.min.css">
  
  <!-- Revolution Slider -->
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/fonts/pe-icon-7-stroke/css/pe-icon-7-stroke.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/fonts/font-awesome/css/font-awesome.css">

  <!-- REVOLUTION STYLE SHEETS -->
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/settings.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/layers.css">
  <link rel="stylesheet" type="text/css" href="plugins/revolution-slider/revolution/css/navigation.css">
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="css/style.css">
<style>

#deskHeading {
	display: block;
}
button .product-remove{
	font-weight: bold;
	opacity: 0.75;
}
button .product-remove:hover{
	opacity: 1;
}

#trashbtn{display: block}
#trashbtnmob{display: none;}
.hid{display: none;}
.hid1{display: block;}

.product-list .pull-right{float: none!important}

@media (max-width: 992px){
		.container {
				    width: 800px;
				}
}

@media only screen and (max-width: 768px) {
		.container {
				    width: 100%;
				}
		
		#deskHeading{
			display: none;
		}
		.hid{display: block;}
		.hid1{display: none;}
		#trashbtn{display: none;}
  		#trashbtnmob{display: block;margin-top: 20px;}
		.page-wrapper {padding: 0px 0px 40px 0px;}
}
@media only screen and (max-width: 408px) {
	.col-xs-7,.col-xs-5{padding-left: 5px;padding-right: 5px;}	
	    .product-list .pull-right{float: right!important}
		.row .text-center #cartimg {
		    height: auto;
		    vertical-align: middle;
		    width: 100%;
		}			
		.pull-left {
			float: right!important;
		}
}

@media only screen and (min-width: 100px) and (max-width: 770px) {
    br {
        display: none;
    }
    .hid{margin-top: 10px;}
    .pull-right{margin-top: 10px;}
}
  </style>


  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
	<script type="text/javascript">

	$(document).ready(function () {
	    // Handler for .ready() called.
	    $('html, body').animate({
	        scrollTop: $('#scroll').offset().top
	    }, 'slow');
	});

	</script>

</head>

<body id="body">
<!-- Start Top Header Bar -->

<%- include('partials/header') %>



<section class="page-header">
	<div class="container" id="scroll">
		<div class="row">
			<div class="col-md-12">
				<div class="content">
					<h1 class="page-name">Dashboard</h1>
					<ol class="breadcrumb">
						<li><a href="/">Home</a></li>
						<li class="active">My Wishlist</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
</section>

<% if( smsg.length != 0){ %>
 <div class="alert alert-success alert-dismissible">
   <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
    <strong><%= smsg %></strong>
  </div>
   <% } %>

   <% if( delmsg.length != 0){ %>
 <div class="alert alert-success alert-dismissible">
   <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
    <strong><%= delmsg %></strong>
  </div>
   <% } %>


<section class="user-dashboard page-wrapper">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <ul class="list-inline dashboard-menu text-center">
          <li><a href="/profile-details">Profile</a></li>
          <li><a href="/address">Address</a></li>
          <li><a href="/order">Orders</a></li>
          <li><a class="active" href="/wishlist">Wishlist</a></li>
          
        </ul>
        <div class="dashboard-wrapper dashboard-user-profile">
    <%  if(foundwishlist.length > 0){	%>    	
      <%  if(foundwishlist){	%>
        <%	for(i in foundwishlist){ %>
	      <div class="row">
	        <div class="col-md-12">
	          <div class="block">
	            <div class="product-list">
	            
	              	
	              	<div class="row" style="padding: 15px 0px;">
	              		<div class="col-lg-9 col-md-8 col-sm-8 col-xs-12">
	              			<div class="col-lg-3 col-md-4 col-sm-5 col-xs-5 text-center">
	              				<img id="cartimg" width="150" height="150" src="<%= foundwishlist[i].img %>" alt="" />
	              				
	              			</div>
	              			<div class="col-lg-6 col-md-8 col-sm-7 col-xs-7">
								<a href="/products/<%= foundwishlist[i].name %>">
								<b><%= foundwishlist[i].name %></b>
								 </a>
								 <p class="limittext"><%= foundwishlist[i].desc %></p>
								<br>
								<b class="hid">₹ <%= foundwishlist[i].price %></b>
								<form method="POST" action="/deletewishlist" >
									<input type="hidden" name="productId" value="<%= foundwishlist[i]._id %>">
							
									<input type="hidden" name="userId" value="<%= usr._id %>">
									<button type="submit" class="product-remove" style="background: transparent;border: 0px;color:#c7254e;"><i class="fa fa-trash" aria-hidden="true"></i></button>
								</form>
	              			</div>
	              		</div>
	              		<div class="col-lg-1 col-md-1 col-sm-1 col-xs-4 hid1">
	              			<label for="" >Price</label> <br>₹ <%= foundwishlist[i].price %>
	              		</div>
	              		<div class="col-lg-2 col-md-3 col-sm-3 col-xs-12 text-center">
	              			<!-- <a href="/cart" class="btn btn-main pull-right">Add To cart</a> -->
	              				<form method="POST" action="/cart">
									<input type="hidden" name="userId" value="<%= usr._id %>">	
									<input type="hidden" name="productId" value="<%= foundwishlist[i].productId %>">
									<input type="hidden" name="quantity" value="1">
									<input type="hidden" name="name" value="<%= foundwishlist[i].name %>">
									<input type="hidden" name="desc" value="<%= foundwishlist[i].desc %>">
									<input type="hidden" name="img" value="<%= foundwishlist[i].img %>">
									<input type="hidden" name="price" value="<%= foundwishlist[i].price %>">
									
									<button type="submit" class="btn btn-main pull-right">Add To Cart</button>
									</form>
	              		</div>	
	              		
	              	</div>
	           <%   }  %>
	<%	}  %>
	              <!-- 	SECOND PRODUCT DIV -->
<% }else{ %>

		<section class="empty-cart page-wrapper">
			  <div class="container">
			    <div class="row">
			      <div class="col-md-12 ">
			        <div class="block text-center">
			        	<i class="tf-ion-ios-heart-outline"></i>
			          	<h2 class="text-center">Your Wishlist is currently empty.</h2>
			          	<p>Add some products to your Wishlist.</p>
			          	<a href="/shop" class="btn btn-main mt-20">Return to shop</a>
			      </div>
			    </div>
			  </div>
			</section>

<% } %>


	              	<!-- =============== END PRODUCTS===================-->

	              	
	  <%  if(foundwishlist.length > 0){	%> 
      
      <% let ttl = 0;  %>
      				<hr>
	              	<div class="row">
	              		<div class="col-lg-3 col-md-4 col-sm-4 col-lg-offset-9 col-md-offset-8  col-sm-offset-8">
	              			<div class="col-md-8 col-sm-7 col-xs-8">
	              				<label for="">Sub Total</label>
	              			</div>
	              			<div class="col-md-4 col-sm-5 col-xs-4">
	              			 <%	for(i in foundwishlist){ %>
	              			 <% ttl= ttl + foundwishlist[i].price %>
	              				
	                           <%   }  %>
	                           ₹ <%= ttl %>
	              			</div>

	              		</div>	
	              	</div>

	<%	}  %>
	               
	             
	            </div>
	          </div>
	        </div>
	      </div>
    	</div><!--  DASHBOARD -->
  	  </div><!--  COL_MD_12 -->

        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

  </body>
  </html>
