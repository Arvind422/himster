 <script>
    var cnqr = {
  
  init: function() {
    // this.persistentData = ['Home', 'Office'];
    this.data = ['Hohem iSteady Mobile+', 'Hohem iSteady Multi', 'Hohem iSteady Pro 3', 'Hohem iSteady X', 'Hohem iSteady Gear (Z Kit)' , 'Hohem iSteady Gear', 'Hohem iSteady X (White)', 'Mini Tripod', 'Tripod' , 'Smartphone Holder' , 'Gimbal' , 'Accessories' , 'New'];
    this.data.sort();
    
    $('.search-field').on('keyup', this.onSearchChange.bind(this));
    $('.search-field1').on('keyup', this.onSearchChange.bind(this));
    $('.search').on('click', this.onContainerClick.bind(this));
    
    // $('#personal-locations').html(this.listToHTML(this.persistentData));
    $('#full-list').html(this.listToHTML(this.data));
    
    // this.data = this.persistentData.concat(this.data);
    this.data.sort();
    
    $('.search-field').focus();
    $('.search-field1').focus();
  },
  
  filter: function(list, filter) {
  
    filter = (filter+'').toLowerCase();

    var result = [];

    for (var i = 0; i < list.length; i++) {
      if (!filter || list[i].toLowerCase().indexOf(filter) >= 0) {
        result.push(list[i]);
      }
    }

    return result;
  },

  injectHighlight: function(list, search) {
  
    if (!search || !list || !list.length) { return list; }

    var output = [];
    
    for (var i = 0; i < list.length; i++) {
      var item = list[i],
          re = new RegExp(search, 'mig'),
          last = 0,
          result = '';

      var match = re.exec(item);

      while (match) {
        result += item.substr(last, match.index - last);

        result += '<span class="highlight">'+match[0]+'</span>';
        last = match.index + search.length;
        match = re.exec(item);
      }

      result += item.substr(last, item.length - last);
      output.push(result);
    }
    
    return output;
  },

  listToHTML: function(textList, formattedList) {
    formattedList = formattedList || textList;
    var output = [];
    for (var i = 0; i < textList.length; i++) {
      if (textList[i] == 'Gimbal' || textList[i] =='Accessories' || textList[i] == 'New') {
      output.push('<div class="result-list-entry" data-value="'+textList[i]+'"><a href="/shop/'+textList[i]+'">'+formattedList[i]+'</a></div>');
        }
        else
          { output.push('<div class="result-list-entry" data-value="'+textList[i]+'"><a href="/products/'+textList[i]+'">'+formattedList[i]+'</a></div>');
          }
    }

    return output.length ? output.join(' ') : '<div class="no-results">No results found</div>';
  },

  onSearchChange: function() {

    var value = $('.search-field').val();

    if (value) {
      $('.search-results').show();
    } else {
      $('.search-results').hide();
    }

    var value1 = $('.search-field1').val();
    if (value1) {
      $('.search-results1').show();
    } else {
       $('.search-results1').hide();
    }

    var textResult = this.filter(this.data, value),
        formattedResult = this.injectHighlight(textResult, value);
    var textResult1 = this.filter(this.data, value1),
        formattedResult1 = this.injectHighlight(textResult, value1);
    

    $('.search-results').html(this.listToHTML(textResult, formattedResult));
    $('.search-results1').html(this.listToHTML(textResult1, formattedResult1));
  },
  
  onContainerClick: function(e) { 
    if ($(e.target).hasClass('result-list-entry')) {
      this.onEntryClick(e.target);
    }
  },
  
  onEntryClick: function(el) {
    $('.search-field').val($(el).data('value'));
    this.onSearchChange();
    $('.search-field1').val($(el).data('value1'));
    this.onSearchChange();
  }
}

cnqr.init();
  </script>

<script>
  $(document).mouseup(function(e) 
{
    var container = $("#search-results");

    // if the target of the click isn't the container nor a descendant of the container
    if (!container.is(e.target) && container.has(e.target).length === 0) 
    {
        container.hide();
    }
});
</script>
<script> 
$(function () {
    var maxL = 70;
    
    $('.limittext').each(function () {
        
        var text = $(this).text();
        if(text.length > maxL) {
            
            var begin = text.substr(0, maxL),
                end = text.substr(maxL);

            $(this).html(begin)
                .append($('<a class="readmore"/>').html('...'))
                .append($('<div class="hidden" />').html(end));
        }
     
    });
            
    $(document).on('click', '.readmore', function () {
        // $(this).next('.readmore').fadeOut("400");
        $(this).next('.hidden').slideToggle(400);
    })        
    
    
})
</script>     

    

