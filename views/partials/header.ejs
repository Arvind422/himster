				</form> 
				<div style="display:none" class="result-list search-results"></div>    
			</div>
			<div class="col-xs-12 visible-xs">
				<div class="logo text-center">
					<a href="/">
						<!-- replace logo here -->
						<img src="images\logo.png" alt="" width="150" height="30">
					</a>
				</div>
			</div>	
			<div class="col-md-3 col-xs-12 col-sm-4 pdt-20">
				<!-- Cart -->
				<ul class="top-menu text-right list-inline">
	          <li class="dropdown cart-nav dropdown-slide">
	          
	         
	            <a href="/cart"><i class="tf-ion-android-cart"></i>Cart</a>


	          
	          </li><!-- / Cart -->
				<!-- Wishlist -->
	          <li>
	          
	          	<a href="/wishlist"><i class="tf-ion-ios-heart"></i>Wishlist</a>
	         
	          </li>
			 <!--  / Wishlist -->
	          <!-- Search -->
	          <li class="dropdown search dropdown-slide visible-xs">
	            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown"><i class="tf-ion-ios-search-strong"></i> Search</a>
	            <ul class="dropdown-menu search-dropdown">
	              <li><form><input type="search" class="form-control search-field1" placeholder="Search..."></form>
	              <div style="display:none" class="result-list search-results1"></div>
	              </li>
	            </ul>	
	          </li><!-- / Search -->

	          	
	        	</ul><!-- / .nav .navbar-nav .navbar-right -->
			</div>
		</div>
	</div>
</section><!-- End Top Header Bar -->


