<style>


	.contact-number ul .dropdown-menu{right: auto}

	.contact-number ul .dropdown-menu li a {
    color: #222;
    font-size: 12px;
    border: 1px solid transparent;
    display: block;
    padding: 8px 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: .3s all;
	}

	.contact-number ul .dropdown-menu>li>a {
    display: block;
    /*padding: 3px 20px;*/
    clear: both;
    font-weight: 400;
    line-height: 1.42857143;
    color: #333;
    white-space: nowrap;
	}

	.contact-number ul .dropdown-menu li a:hover {
    background-color: #000;
    color: #fff;
	}

	.dropdown-menu .divider {
    margin: 4px 0;
	}

	.footer .footer-menu li {
		display: block;
	}
	.footer .footer-menu li a:hover {
		color:black;
	}
	.footer .footer-menu li a{
	color:#6d6d6dc4;
	font-weight:bold;
	font-size: 14px; 
	}
	.col-lg-12{float: none;}

	 @media only screen and (max-width: 400px){
    .btn-main {padding: 14px 8px;}
	}
	@media (max-width: 992px){
	.container {
    width: 100%;
	}
}
</style>	

</head>

<body id="body">

<!-- Start Top Header Bar -->

<%- include('partials/header') %>


<section class="page-header">
	<div class="container">
		<div class="row">
			<div class="col-md-12">
				<div class="content">
					<h1 class="page-name">Edit Address</h1>
					<ol class="breadcrumb">
						<li><a href="/">Home</a></li>
						<li><a href="/profile-details"></a>My Account</li>
						<li class="active">Edit Address</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
</section>


<section class="edit-address-page account">
  <div class="container">
    <div class="row">
      <div class="col-md-6 col-md-offset-3">
        <div class="block text-center">
          
          <h2 class="text-center">Edit Address</h2>
          
          <form class="text-left clearfix" action="/editaddress" method="POST">
            
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="First Name" name="firstname" value="<%= usr.firstname %>" required>
            </div>
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="Last Name" name="lastname" value="<%= usr.lastname %>" required>
            </div>
           
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="Address(House No,Building)" name="address" required>
            </div>
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="Locality / Town" name="town" required>
            </div>
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="City / District" name="city" required>
            </div>
             <div class="form-group">
              <input type="tel" class="form-control" id="" placeholder="Pincode" name="pincode" required>
            </div>
            <div class="form-group">
              <input type="text" class="form-control" id="" placeholder="State" name="state" required>
            </div>

            <div class="form-group">
              <p>Type of Address</p>
                <input type="radio" id="home" name="typeofaddress" value="Home" required>
        <label for="home">Home</label>
        <input type="radio" id="office" name="typeofaddress" value="Office" required>
        <label for="office">Office</label>
            </div>
            <input type="hidden" name="addid" value="<%= addid %>">
            <!-- <input type="hidden" name="phone" value="<%= usr.phone %>"> -->
            <div class="text-center">
              <button type="submit" class="btn btn-main text-center">save</button>
            </div>
          </form>

          <p class="mt-20"><a href="/address">Go Back</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

  </body>
  </html>